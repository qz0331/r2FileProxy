# 服务配置
SERVER_PORT=8080
# 必填：用于签名 Session Cookie，请使用随机字符串（openssl rand -hex 32）
SERVER_SECRET=your-session-secret-change-me
# HTTPS 部署时设为 true（Cookie 只通过 HTTPS 发送）
SECURE_COOKIE=false
# 反向代理地址，逗号分隔（默认信任本机 127.0.0.1 / ::1；设为 * 表示全部信任）
# TRUSTED_PROXIES=127.0.0.1,::1
# 对外访问地址，用于生成分享链接（留空则根据请求自动推断）
# PUBLIC_BASE_URL=https://files.example.com

# 首次启动自动创建的管理员（数据库为空时生效）
# ADMIN_PASSWORD 不设置会自动生成随机密码并打印在启动日志里
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# 安全入口（隐藏登录入口，可留空表示关闭）
# SECURITY_ENTRY=myvault

# R2 配置
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-bucket.your-domain.com

# 限制（可选，支持 1024 / 10MB / 2G 写法）
# MAX_DOWNLOAD_SIZE=2G   # 单个 URL 下载任务上限，默认 2 GiB
# MAX_UPLOAD_SIZE=2G     # 分享页 / 代理上传单文件上限，默认 2 GiB

# 数据库
DATABASE_URL=r2proxy.db
